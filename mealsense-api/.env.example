# Copy this file to `.env` (gitignored) and fill in real values.

# Required for services/menu_ingestion/llm_enrichment.py's Claude-assisted
# fallback (design-spec.md §7.0a, tasks.md 3.6) — vendor-sync ingestion only.
# Get one at https://console.anthropic.com (Settings -> API Keys). Without
# this set, enrichment silently no-ops (AnthropicNotConfiguredError, caught)
# and ingestion behaves exactly as it did before this feature existed.
ANTHROPIC_API_KEY=
